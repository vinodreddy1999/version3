# Copy to .env and fill in real values for local development / deployment.

# Defaults to a local SQLite file if unset — fine for local dev.
# For real deployments use Postgres, e.g.:
# DATABASE_URL=postgresql://metam:changeme@localhost:5432/metam
DATABASE_URL=sqlite:///./metam.db

# Must be set to a long random value in any shared/deployed environment.
# If left unset, a random secret is generated per process (tokens won't
# survive a restart) — fine for a single local dev run, never for prod.
JWT_SECRET=

ENVIRONMENT=development

# Used to build links in emails (e.g. password reset).
FRONTEND_BASE_URL=http://localhost:5173

# Password reset emails: if SMTP_HOST is unset, emails are logged instead of
# sent (fine for local dev, never for a shared/deployed environment).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@metam.local
SMTP_USE_TLS=true

# Local disk directory attachment uploads are written to (relative to the
# process's working directory). Mount a volume there in production so
# uploads survive container restarts — see docker-compose.yml.
ATTACHMENTS_DIR=./data/attachments
