# Copy to .env for `docker compose up`.

POSTGRES_USER=metam
POSTGRES_PASSWORD=changeme
POSTGRES_DB=metam

# Long random value — required for docker-compose deployments.
JWT_SECRET=

# Base URL the frontend's JS calls at runtime; baked in at frontend build time.
VITE_API_BASE_URL=http://localhost:8000

# Used to build links in password-reset emails.
FRONTEND_BASE_URL=http://localhost:8080

# Password reset emails: if unset, emails are logged instead of sent (fine
# for a demo deployment, never for real users).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@metam.local
SMTP_USE_TLS=true
