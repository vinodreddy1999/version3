# Copy to .env for `docker compose up`.

POSTGRES_USER=metam
POSTGRES_PASSWORD=changeme
POSTGRES_DB=metam

# Long random value — required for docker-compose deployments.
JWT_SECRET=

# The hostname people will use to reach the app. Caddy (the caddy service)
# uses this to request a Let's Encrypt certificate automatically — point
# DNS at this host's IP *before* running `docker compose up` and there is
# nothing else to configure for HTTPS. No domain yet? Set this to
# `localhost` (or the server's bare IP) and Caddy issues a locally-trusted
# cert instead — browsers will show a one-time warning since it isn't from
# a public CA, but everything else works the same.
DOMAIN=

# Base URL the frontend's JS calls at runtime; baked in at frontend build
# time. Leave as /api (Caddy proxies it to the backend, same-origin)
# unless you're splitting frontend and backend across separate hosts.
VITE_API_BASE_URL=/api

# Used to build links in password-reset emails. Defaults to https://$DOMAIN
# — only set this if the frontend is reachable at a different URL than
# DOMAIN (e.g. a split-domain setup).
FRONTEND_BASE_URL=

# Password reset emails: if unset, emails are logged instead of sent (fine
# for a demo deployment, never for real users).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@metam.local
SMTP_USE_TLS=true

# Local disk directory attachment uploads are written to inside the backend
# container. Persisted via the attachments-data volume in docker-compose.yml.
ATTACHMENTS_DIR=./data/attachments
